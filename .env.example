# =============================================================
# RecallX — Blockchain Verification Module (.env)
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================

# ---------- Blockchain RPC ----------
# For local development (Anvil / Hardhat):
#   RPC_URL=http://127.0.0.1:8545
# For Sepolia testnet (Alchemy example):
#   RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
RPC_URL=http://127.0.0.1:8545

# ---------- Account ----------
# Private key of the deployer / signer account.
# For Anvil, use one of the default accounts.
# NEVER use a mainnet key with real funds.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ---------- Chain ID ----------
# Local (Anvil/Hardhat): 31337
# Sepolia:               11155111
CHAIN_ID=31337

# ---------- Contract ----------
# Filled in after running deploy.py
CONTRACT_ADDRESS=
